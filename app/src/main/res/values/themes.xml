<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartPantryManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pantry_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pantry_green_light</item>
        <item name="colorOnPrimaryContainer">@color/pantry_green_dark</item>
        <item name="colorSecondary">@color/pantry_orange</item>
        <item name="android:colorBackground">@color/pantry_background</item>
        <item name="android:statusBarColor">@color/pantry_green_dark</item>
        <item name="android:textColorPrimary">@color/pantry_text</item>
        <item name="android:textColorSecondary">@color/pantry_text_secondary</item>
    </style>

    <!-- Toolbar icons (Up arrow, three dots) are white on the green bar -->
    <style name="ThemeOverlay.SmartPantry.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/toolbar_icon</item>
    </style>

    <!-- The dropdown menu opens on a light background, so its text must be dark.
         Without this the menu inherits the toolbar's white text and becomes unreadable. -->
    <style name="ThemeOverlay.SmartPantry.Popup" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/pantry_text</item>
        <item name="android:textColorSecondary">@color/pantry_text_secondary</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:colorBackgroundFloating">@color/white</item>
    </style>
</resources>
